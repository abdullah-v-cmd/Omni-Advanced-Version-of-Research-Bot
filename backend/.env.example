# OmniSynth Environment Configuration
# Copy this file to .env and fill in your actual values

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=OmniSynth
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (sandbox/local dev):
DATABASE_URL=sqlite+aiosqlite:///./omnisynth.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://omnisynth:omnisynth_pass@postgres:5432/omnisynth_db

# ─── Redis (optional — service degrades gracefully if unavailable) ─────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Groq AI — REQUIRED ───────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=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
# Current active models (updated 2024 — old llama3-70b-8192 / mixtral models decommissioned):
GROQ_MODEL_PRIMARY=llama-3.3-70b-versatile
GROQ_MODEL_SECONDARY=llama-3.1-8b-instant
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.7

# ─── HuggingFace Embeddings (optional) ───────────────────────────────────────
HUGGINGFACE_API_KEY=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── FAISS Vector Store ───────────────────────────────────────────────────────
FAISS_INDEX_PATH=./data/faiss_index
FAISS_DIMENSION=384

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ─── Default Admin User ───────────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@omnisynth.ai
FIRST_SUPERUSER_PASSWORD=Admin@123456

# ─── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=20
